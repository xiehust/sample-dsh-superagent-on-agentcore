#!/usr/bin/env python3
"""git credential helper: an installation token for the cell's repo, from worker-api through the gateway's local proxy.

The token is cached under the agent's HOME until 5 minutes before it expires. `gh` uses it via the `gh` wrapper (GH_TOKEN).
Usage by git: `git-credential-dshsa get` (reads key=value lines on stdin). Usage by the wrapper: `git-credential-dshsa token`.
"""
import json
import os
import sys
import time
import urllib.request
from datetime import datetime

PROXY = os.environ.get("CP_PROXY", "http://127.0.0.1:8090/cp")
CACHE = os.path.join(os.environ.get("HOME", "/tmp"), ".dshsa-github-token.json")


def token() -> str:
    try:
        with open(CACHE) as f:
            cached = json.load(f)
        if datetime.fromisoformat(cached["expiresAt"].replace("Z", "+00:00")).timestamp() - time.time() > 300:
            return cached["token"]
    except (OSError, ValueError, KeyError):
        pass
    req = urllib.request.Request(f"{PROXY}/v1/credentials/github", data=b"{}", method="POST", headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:  # noqa: S310 - loopback proxy
        data = json.loads(resp.read())
    fd = os.open(CACHE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    return data["token"]


def main() -> None:
    op = sys.argv[1] if len(sys.argv) > 1 else ""
    if op == "token":
        print(token())
        return
    if op != "get":
        return
    request = dict(line.split("=", 1) for line in sys.stdin.read().splitlines() if "=" in line)
    if request.get("host", "github.com") != "github.com":
        return
    print("username=x-access-token")
    print(f"password={token()}")


if __name__ == "__main__":
    main()
